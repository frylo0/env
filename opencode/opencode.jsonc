{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-luna",
  "shell": "xonsh",
  "permissions": [
    { "action": "read",  "resource": "*skills/opencode-tpl/*secrets*", "effect": "deny" },
    { "action": "glob",  "resource": "*skills/opencode-tpl/*secrets*", "effect": "deny" },
    { "action": "grep",  "resource": "*skills/opencode-tpl/*secrets*", "effect": "deny" },
    { "action": "write", "resource": "*skills/opencode-tpl/*secrets*", "effect": "deny" },
    { "action": "edit",  "resource": "*skills/opencode-tpl/*secrets*", "effect": "deny" }
  ]
}